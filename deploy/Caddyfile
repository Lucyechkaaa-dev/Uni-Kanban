# Public HTTPS entry. Caddy gets a Let's Encrypt certificate for PUBLIC_HOST automatically.
# Values come from the project .env: PUBLIC_HOST, PUBLIC_PORT, FRONTEND_PORT.
# Requires router forwards: external 80 -> this PC 80, and external PUBLIC_PORT -> this PC PUBLIC_PORT.

{$PUBLIC_HOST}:{$PUBLIC_PORT} {
	reverse_proxy 127.0.0.1:{$FRONTEND_PORT}
}
