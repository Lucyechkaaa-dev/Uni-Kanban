# Uni-Kanban configuration template. Copy to .env (same folder) and fill in your values.
# .env is git-ignored; never commit it.

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USER=your_db_user
DB_PASS=your_db_password
DB_SCHEMA=public

# --- Backend (Spring Boot, runs locally) ---
BACKEND_PORT=8081
# true behind HTTPS (Caddy); false for plain http://localhost
APP_COOKIE_SECURE=false

# --- Frontend (Vite dev server, localhost only) ---
FRONTEND_PORT=5173

# --- Public HTTPS entry (Caddy) ---
PUBLIC_HOST=your-host.example.com
PUBLIC_PORT=2345

# --- Tools (paths on this machine) ---
MAVEN_HOME=C:\path\to\apache-maven
CADDY_EXE=C:\path\to\caddy.exe
